# Copy to .env.local and fill in. Never commit real values.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…). Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…). Server only: guest form submissions, private uploads, signed URLs.
# Bypasses Row Level Security. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Resend (transactional email)
RESEND_API_KEY=
EMAIL_FROM="Ride Out <no-reply@example.com>"
# Comma-separated inboxes that receive new-request alerts
ADMIN_NOTIFICATION_EMAILS=

# Cloudflare Turnstile (bot protection on public forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
